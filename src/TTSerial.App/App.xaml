<Application x:Class="TTSerial.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Shell" Color="#BECFE4" /><SolidColorBrush x:Key="Edge" Color="#728BA6" />
    <SolidColorBrush x:Key="TitleInk" Color="#182C44" /><SolidColorBrush x:Key="Screen" Color="#101725" />
    <SolidColorBrush x:Key="Ink" Color="#D6EAF7" /><SolidColorBrush x:Key="Muted" Color="#A8BED3" />
    <SolidColorBrush x:Key="Accent" Color="#68E0DA" /><SolidColorBrush x:Key="Workspace" Color="#E9EFF6" />
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI" /><Setter Property="FontSize" Value="13" /><Setter Property="Background" Value="{DynamicResource Workspace}" /><Setter Property="Foreground" Value="{DynamicResource TitleInk}" /></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="10,5" /><Setter Property="Margin" Value="0,0,6,0" /><Setter Property="MinHeight" Value="29" /><Setter Property="Background" Value="{DynamicResource Shell}" /><Setter Property="Foreground" Value="{DynamicResource TitleInk}" /><Setter Property="BorderBrush" Value="{DynamicResource Edge}" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.6" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4" /><Setter Property="MinHeight" Value="29" /><Setter Property="Background" Value="{DynamicResource Screen}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="BorderBrush" Value="{DynamicResource Edge}" /><Setter Property="CaretBrush" Value="{DynamicResource Ink}" /><Setter Property="SelectionBrush" Value="{DynamicResource Edge}" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="29" /><Setter Property="Padding" Value="6,3" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Foreground" Value="#182C44" /><Setter Property="Background" Value="#E0E9F3" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Margin" Value="0,3,10,3" /></Style>
    <Style TargetType="Expander"><Setter Property="Margin" Value="0,4,0,4" /></Style>
    <Style x:Key="PanelFrame" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Shell}" /><Setter Property="BorderBrush" Value="{DynamicResource Edge}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="5" /></Style>
    <Style x:Key="PanelBody" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Screen}" /><Setter Property="BorderBrush" Value="{DynamicResource Edge}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="3" /><Setter Property="Padding" Value="10" /></Style>
  </Application.Resources>
</Application>
