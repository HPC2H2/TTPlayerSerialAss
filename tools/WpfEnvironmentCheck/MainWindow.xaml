<Window x:Class="WpfEnvironmentCheck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="C# / WPF 环境验证" Width="780" Height="460"
        WindowStartupLocation="CenterScreen">
  <Grid x:Name="RootPanel" Background="#F2F5FA">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="30,25,30,15">
      <TextBlock Text="C# + WPF 环境已就绪" FontSize="25" Foreground="#18314D" />
      <TextBlock Margin="0,8,0,0" Text=".NET 10 · XAML 编译 · 数据绑定 · 图形渲染" FontSize="14" Foreground="#4C6380" />
    </StackPanel>
    <Border Grid.Row="1" Margin="30,5,30,15" Background="#152539" CornerRadius="7" Padding="20">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TextBlock Text="WPF 图形验证 · 静态示意" Foreground="#DCE9F5" FontSize="14" />
        <Viewbox Grid.Row="1" Stretch="Fill" Margin="0,20,0,10">
          <Canvas Width="650" Height="100">
            <Line X1="0" Y1="50" X2="650" Y2="50" Stroke="#49627C" StrokeThickness="1" />
            <Polyline Stroke="#66DED1" StrokeThickness="2.5" StrokeLineJoin="Round"
                      Points="0,50 20,25 40,10 60,25 80,50 100,75 120,90 140,75 160,50 180,25 200,10 220,25 240,50 260,75 280,90 300,75 320,50 340,25 360,10 380,25 400,50 420,75 440,90 460,75 480,50 500,25 520,10 540,25 560,50 580,75 600,90 620,75 650,50" />
          </Canvas>
        </Viewbox>
      </Grid>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="30,0,30,25">
      <Button x:Name="TestButton" Content="测试 C# 事件与绑定" Padding="15,8" Click="TestButton_Click" />
      <TextBlock x:Name="CountLabel" Text="{Binding CountText}" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="#18314D" FontSize="14" />
    </StackPanel>
  </Grid>
</Window>
